# LunaGPT Environment Configuration
# Скопируйте этот файл в .env и заполните ключи: cp .env.example .env

# ==============================================================================
# 1. API Ключи облачных провайдеров (для LiteLLM Router)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Мастер-ключ для доступа к LiteLLM Proxy из клиентов (VS Code, Open WebUI, Python)
LITELLM_MASTER_KEY=sk-luna-master-key-2026

# Хост локальной Ollama (на хостовой машине Linux с GPU RX 580)
OLLAMA_API_BASE=http://host.docker.internal:11434

# ==============================================================================
# 2. Настройки Langfuse (Трейсинг, метрики, аудит затрат и промптов)
# ==============================================================================
# Если используете локальный Langfuse (из docker-compose.yml):
# Хост внутри Docker сети: http://langfuse-server:3000
# Хост для браузера: http://localhost:3001
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PUBLIC_KEY=pk-lf-luna-local-public-key
LANGFUSE_SECRET_KEY=sk-lf-luna-local-secret-key

# База данных для локального Langfuse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lunagpt_secure_postgres_pass
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://postgres:lunagpt_secure_postgres_pass@langfuse-db:5432/langfuse
NEXTAUTH_SECRET=lunagpt_nextauth_secret_random_string_32chars
SALT=lunagpt_salt_random_string_value_32ch
NEXTAUTH_URL=http://100.65.202.127:3001
AUTH_TRUST_HOST=true

# (Опционально) Если захотите переключиться на Langfuse Cloud:
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-cloud-...
# LANGFUSE_SECRET_KEY=sk-lf-cloud-...

# ==============================================================================
# 3. Настройки Open WebUI (Интерфейс пользователя)
# ==============================================================================
WEBUI_SECRET_KEY=lunagpt_webui_super_secret_key
WEBUI_PORT=3000
LITELLM_PORT=4000
LANGFUSE_PORT=3001
