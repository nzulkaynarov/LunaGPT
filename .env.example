# LunaGPT Environment Configuration
# Скопируйте этот файл в .env и заполните ключи: cp .env.example .env

# ==============================================================================
# 1. API Ключи облачных провайдеров (для LiteLLM Router)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Мастер-ключ для доступа к LiteLLM Proxy и Core API (замените на случайный токен)
LITELLM_MASTER_KEY=sk-luna-change-me-to-a-secure-random-token

# Хост локальной Ollama (на хостовой машине Linux)
OLLAMA_API_BASE=http://host.docker.internal:11434

# ==============================================================================
# 2. Redis Cache & Rate Limiting
# ==============================================================================
REDIS_PASSWORD=change_me_to_a_secure_redis_password

# ==============================================================================
# 3. Настройки Langfuse (Трейсинг, метрики, аудит затрат и промптов)
# ==============================================================================
# Внутри Docker-сети: http://langfuse-server:3000, для браузера: http://localhost:3001
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me

# PostgreSQL база данных (pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_postgres_password
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@langfuse-db:5432/langfuse
NEXTAUTH_SECRET=change_me_to_a_random_32char_string_for_nextauth
SALT=change_me_to_a_random_32char_string_for_salt
NEXTAUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true

# ==============================================================================
# 4. Настройки Open WebUI (Интерфейс пользователя)
# ==============================================================================
WEBUI_SECRET_KEY=change_me_to_a_secure_webui_secret_key
WEBUI_PORT=3000
LITELLM_PORT=4000
LANGFUSE_PORT=3001

# Langfuse admin password (applied only when the admin user is first created)
LANGFUSE_ADMIN_PASSWORD=change_me_to_a_secure_langfuse_password

# Host-side database URLs for local tests and scripts (containers get their own from compose)
LUNAGPT_DATABASE_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@localhost:5433/lunagpt
OPENWEBUI_DATABASE_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@localhost:5433/openwebui

# Per-client gateway key for HomeSec (create with POST /key/generate); also accepted by Core API for speech
LITELLM_HOMESEC_KEY=
CORE_API_KEY=

# Luna AI Assistant: bot token from @BotFather and a gateway key with its own budget
LUNA_TELEGRAM_BOT_TOKEN=
LITELLM_ASSISTANT_KEY=
# Shared with HS_LUNA_API_TOKEN on the Raspberry Pi
LUNA_PI_API_TOKEN=
# Google Calendar for Luna: the service account JSON key on one line, see docs/google-calendar.md
LUNA_GOOGLE_SERVICE_ACCOUNT=
